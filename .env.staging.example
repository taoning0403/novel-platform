# Copy to /srv/novel-platform/config/.env.staging on the server and chmod 600.
# Every replace-with value is a non-secret placeholder and must be replaced before deployment.
ENVIRONMENT=staging
PUBLIC_BASE_URL=https://reading.example.invalid
STAGING_HTTP_PORT=8080
STAGING_POSTGRES_DATA_DIR=/srv/novel-platform/data/postgres
STAGING_LIBRARY_DATA_DIR=/srv/novel-platform/data/library
STAGING_BACKUP_DIR=/srv/novel-platform/data/backups
STAGING_REPORT_DIR=/srv/novel-platform/reports
STAGING_STATE_FILE=/srv/novel-platform/config/staging-acceptance-state.json

POSTGRES_DB=novel_platform
POSTGRES_USER=novel_platform
POSTGRES_PASSWORD=replace-with-random-database-password

CORS_ORIGINS='["https://reading.example.invalid"]'
TRUSTED_HOSTS='["reading.example.invalid","127.0.0.1"]'
LOG_LEVEL=INFO
AUTH_JWT_SECRET=replace-with-independent-random-jwt-secret
AUTH_HASH_SECRET=replace-with-independent-random-hash-secret
AUTH_CREDENTIAL_HASH_SECRET=replace-with-independent-random-credential-hash-secret
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_NAME=novel_refresh
AUTH_DEVICE_COOKIE_NAME=novel_device
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=strict
AUTH_DEVICE_COOKIE_TTL_DAYS=365
AUTH_COOKIE_DOMAIN=
AUTH_ISSUER=novel-platform-staging
AUTH_AUDIENCE=novel-platform-staging-client
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_SECONDS=600
AUTH_LOGIN_BLOCK_SECONDS=900
ADMIN_RECOVERY_TTL_MINUTES=15
WEBAUTHN_RP_ID=reading.example.invalid
WEBAUTHN_RP_NAME='个人数字阅读与藏书整理'
WEBAUTHN_ORIGINS='["https://reading.example.invalid"]'
WEBAUTHN_CHALLENGE_TTL_SECONDS=300
OPENAPI_ENABLED=false
LIBRARY_STORAGE_ROOT=/data/library
MAX_UPLOAD_BYTES=104857600
MAX_EPUB_UNCOMPRESSED_BYTES=524288000
MAX_EPUB_ENTRY_COUNT=10000
MAX_COVER_BYTES=20971520
MAX_COVER_PIXELS=40000000

# Generate independent vault/relay secrets. The relay secret is also the only bearer configured
# in LinguaSpindle; each reader's Provider key remains encrypted in Novel Platform PostgreSQL.
# Set ENABLED=false until the external network, v0.3.2 service, and Relay are verified.
LINGUASPINDLE_ENABLED=false
LINGUASPINDLE_BASE_URL=http://linguaspindle:8765
LINGUASPINDLE_VERSION_RANGE='>=0.3.2,<0.4.0'
LINGUASPINDLE_PROVIDER_ID=openai-compatible
LINGUASPINDLE_PROFILE_ID=
LINGUASPINDLE_CONNECT_TIMEOUT_SECONDS=3
LINGUASPINDLE_READ_TIMEOUT_SECONDS=30
LINGUASPINDLE_MAX_DOWNLOAD_BYTES=104857600
PROVIDER_CREDENTIAL_MASTER_KEY=replace-with-strict-base64-32-byte-key
PROVIDER_RELAY_SERVICE_SECRET=replace-with-independent-relay-service-secret
PROVIDER_RELAY_INTERNAL_URL=http://novel-provider-relay:8790
PROVIDER_RELAY_UPSTREAM_BASE_URL=https://api.openai.com/v1
PROVIDER_RELAY_ALLOWED_MODELS='["gpt-4.1-mini"]'
PROVIDER_RELAY_CONNECT_TIMEOUT_SECONDS=5
PROVIDER_RELAY_READ_TIMEOUT_SECONDS=120
PROVIDER_RELAY_MAX_REQUEST_BYTES=1048576
PROVIDER_RELAY_MAX_RESPONSE_BYTES=4194304

# CLI-generated administrator initialization/recovery credentials are never stored here.
